<?php-namespace Tests\Feature\EchoMap;-use App\Models\Friendship;-use App\Models\Pin;-use App\Models\User;-use Illuminate\Foundation\Testing\RefreshDatabase;-use Tests\TestCase;-/**- * The hard privacy rule from the brief:- * private and friends-only pins must NEVER reach other users- * through /pins, /stories, or the AI clustering pipeline.- */-class PrivacyTest extends TestCase-{-    use RefreshDatabase;-    private function makeUser(string $name = 'user'): User-    {-        return User::factory()->create(['name' => $name]);-    }-    private function makePin(User $owner, string $visibility, array $overrides = []): Pin-    {-        return Pin::create(array_merge([-            'user_id'    => $owner->id,-            'title'      => 'Test pin',-            'body'       => 'Body',-            'latitude'   => 14.55,-            'longitude'  => 121.04,-            'theme'      => 'Memory',-            'visibility' => $visibility,-            'is_hidden'  => false,-        ], $overrides));-    }-    /** A user should never see another user's PRIVATE pins in /pins. */-    public function test_private_pins_do_not_leak_through_pins_endpoint(): void-    {-        $alice = $this->makeUser('alice');-        $bob   = $this->makeUser('bob');-        $alicePublic  = $this->makePin($alice, 'public');-        $aliceFriends = $this->makePin($alice, 'friends');-        $alicePrivate = $this->makePin($alice, 'private');-        $response = $this->actingAs($bob)->getJson('/pins');-        $response->assertOk();-        $ids = collect($response->json())->pluck('id')->all();-        $this->assertContains($alicePublic->id, $ids,  'public pin should be visible');-        $this->assertNotContains($aliceFriends->id, $ids, 'friends-only pin should NOT leak');-        $this->assertNotContains($alicePrivate->id, $ids, 'private pin should NOT leak');-    }-    /** Owners always see their own pins, any visibility. */-    public function test_owner_sees_own_pins_regardless_of_visibility(): void-    {-        $alice = $this->makeUser('alice');-        $public  = $this->makePin($alice, 'public');-        $friends = $this->makePin($alice, 'friends');-        $private = $this->makePin($alice, 'private');-        $response = $this->actingAs($alice)->getJson('/pins');-        $ids = collect($response->json())->pluck('id')->all();-        $this->assertContains($public->id,  $ids);-        $this->assertContains($friends->id, $ids);-        $this->assertContains($private->id, $ids);-    }-    /** Accepted friends see friends-only pins. */-    public function test_friends_see_friends_only_pins(): void-    {-        $alice = $this->makeUser('alice');-        $bob   = $this->makeUser('bob');-        Friendship::create([-            'sender_id'   => $alice->id,-            'receiver_id' => $bob->id,-            'status'      => 'accepted',-        ]);-        $friendsOnly = $this->makePin($alice, 'friends');-        $response = $this->actingAs($bob)->getJson('/pins');-        $ids = collect($response->json())->pluck('id')->all();-        $this->assertContains($friendsOnly->id, $ids);-    }-    /** A PENDING friendship is NOT enough. */-    public function test_pending_friend_does_not_see_friends_only_pins(): void-    {-        $alice = $this->makeUser('alice');-        $bob   = $this->makeUser('bob');-        Friendship::create([-            'sender_id'   => $alice->id,-            'receiver_id' => $bob->id,-            'status'      => 'pending',-        ]);-        $friendsOnly = $this->makePin($alice, 'friends');-        $response = $this->actingAs($bob)->getJson('/pins');-        $ids = collect($response->json())->pluck('id')->all();-        $this->assertNotContains($friendsOnly->id, $ids);-    }-    /** A hidden pin never appears, even to its owner. */-    public function test_hidden_pins_are_never_returned(): void-    {-        $alice = $this->makeUser('alice');-        $pin   = $this->makePin($alice, 'public', ['is_hidden' => true]);-        $response = $this->actingAs($alice)->getJson('/pins');-        $ids = collect($response->json())->pluck('id')->all();-        $this->assertNotContains($pin->id, $ids);-    }-    /** /stories endpoint returns only READY stories. */-    public function test_stories_endpoint_only_returns_ready_stories(): void-    {-        $alice = $this->makeUser('alice');-        $this->makePin($alice, 'public');-        $this->makePin($alice, 'public');-        // No story exists yet - /stories returns empty-        $response = $this->actingAs($alice)->getJson('/stories');-        $response->assertOk();-        $this->assertSame([], $response->json());-    }-    /** Unauthenticated access is blocked. */-    public function test_pins_endpoint_requires_authentication(): void-    {-        $this->getJson('/pins')->assertUnauthorized();-        $this->getJson('/stories')->assertUnauthorized();-    }-}